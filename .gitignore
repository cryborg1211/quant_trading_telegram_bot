# Auto-saved timestamped model backups (churn — regenerated every retrain, "do not index")
models/saved/backups/
# Promote-gate rejects (27-08-26). One 3.3 MB bundle per REJECTED retrain, saved
# purely so a human can inspect why it lost — 12.9 MB across four already, and it
# grows with every rejection. Same churn class as backups/ above: the decision
# itself is in the retrain log, and the bundle is reproducible from the checkpoint.
models/saved/rejected/
# Research checkpoints from one-off studies (26 MB for the two below). The GOLDEN
# checkpoint `v3_training_checkpoint.joblib` IS tracked; these are throwaway
# variants and must not follow it into the history.
models/saved/t20_extended_oos_checkpoint.joblib
models/saved/t20_std_checkpoint.joblib
# CatBoost training scratch dir (recreated every fit)
catboost_info/

