# Quant V6 — required environment variables.
# Copy to `.env` and fill in real values. Never commit `.env` to source control.

# --- Telegram alerter (src/utils/telegram_alerter.py) ---
# Bot token from @BotFather. Comma-separate multiple chat IDs to broadcast.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# --- Google Gemini sentiment LLM (src/models/quant_agent_arbitrator.py) ---
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional override; governs BOTH the sentiment crawler and the arbitrator.
# Defaults to the GA pin "gemini-2.5-flash" if unset. Avoid floating aliases
# like "gemini-flash-latest" — they re-resolve to new models without warning
# (2026-07-07 JSON-drift incident).
GEMINI_MODEL=gemini-2.5-flash

# --- SSI FastConnect Data (src/data/foreign_flow_crawler.py) ---
# Historical foreign-flow backfill. Get these at
# https://iboard.ssi.com.vn/support/api-service/management (needs an SSI
# trading account + a separate FastConnect API registration — see
# process/general-plans/backlog/foreign-flow-fastconnect-integration_PLAN_24-07-26.md).
# Shown ONLY ONCE at creation — save immediately. FC Data needs ONLY these
# two (no PrivateKey/RSA — that's FC Trading, unused here). Requires a fixed
# IP registered on the same iBoard screen; renew every 3 months.
Consumer_Key=YOUR_SSI_CONSUMER_ID
ConsumerSecret_Key=YOUR_SSI_CONSUMER_SECRET
